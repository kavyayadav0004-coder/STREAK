# Neon (or Supabase) Postgres. DATABASE_URL = pooled string, DIRECT_URL = direct string
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/strk?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/strk?sslmode=require"

# Pusher Channels (dashboard.pusher.com > Channels app)
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"
NEXT_PUBLIC_GYM_NAME="YOUR GYM"

# Shared secret the scanner software uses to sign webhooks (openssl rand -hex 32)
WEBHOOK_SECRET=""
# Secret in the TV's URL: /display?key=...  (openssl rand -hex 16)
DISPLAY_KEY=""
# Basic auth for /admin (username is "admin")
ADMIN_PASSWORD=""

GYM_TZ="Asia/Kolkata"
